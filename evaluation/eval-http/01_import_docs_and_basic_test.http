{
  "spaceId": {{spaceId}},
  "query": "/api/rag/eval/runs/compare 接口如何比较 EvalRun 的 MRR？",
  "retrievalMode": "HYBRID_RERANK",
  "topK": 5,
  "candidateK": 20
}

