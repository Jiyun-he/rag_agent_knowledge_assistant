@host = http://localhost:8080
@spaceId = 1
@datasetId = 1


### Case 1：项目整体链路
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "这个项目的完整 RAG 问答链路是什么？",
  "expectedAnswer": "项目链路包括知识库空间创建、文档创建、文本切分、chunk 存储、异步向量化、Qdrant 向量写入、RAG 检索、prompt 构建、大模型回答、问答历史保存和引用追踪。",
  "expectedChunkIds": [1,2],
  "expectedKeywords": ["知识库空间", "文档切分", "异步向量化", "RAG 检索", "引用追踪"],
  "difficulty": "easy"
}

### Case 2：MySQL 与 Qdrant 分工
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "MySQL 和 Qdrant 在系统中分别负责什么？",
  "expectedAnswer": "MySQL 保存知识库、文档、chunk、任务、问答历史和评测记录等结构化数据；Qdrant 保存 chunk embedding 向量并提供向量相似度检索。",
  "expectedChunkIds": [1],
  "expectedKeywords": ["MySQL", "Qdrant", "结构化业务数据", "embedding", "向量检索"],
  "difficulty": "easy"
}

### Case 3：KbChunk 作用
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "KbChunk 在项目中有什么作用？",
  "expectedAnswer": "KbChunk 表示文档切分后的文本片段，是向量化、检索和引用追踪的基本单位。",
  "expectedChunkIds": [3,7],
  "expectedKeywords": ["KbChunk", "文本片段", "向量化", "检索", "引用"],
  "difficulty": "easy"
}

### Case 4：文档创建后处理
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "创建文档后系统会做哪些处理？",
  "expectedAnswer": "系统会校验 spaceId，写入 KbDocument，调用 TextChunker 切分 content，将生成的片段写入 kb_chunk，并更新 chunkCount。",
  "expectedChunkIds": [6,7],
  "expectedKeywords": ["spaceId", "KbDocument", "TextChunker", "kb_chunk", "chunkCount"],
  "difficulty": "easy"
}

### Case 5：vectorize-async
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "/api/rag/documents/{documentId}/vectorize-async 接口的作用是什么？",
  "expectedAnswer": "该接口用于创建并启动文档异步向量化任务，将文档下的 pending chunk 转换为 embedding 并写入 Qdrant。",
  "expectedChunkIds": [8],
  "expectedKeywords": ["vectorize-async", "异步向量化", "pending chunk", "embedding", "Qdrant"],
  "difficulty": "easy"
}

### Case 6：向量化成功字段
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "chunk 向量化成功后会更新哪些字段？",
  "expectedAnswer": "向量化成功后会将 KbChunk 的 embeddingStatus 更新为 1，并写入 vectorId。",
  "expectedChunkIds": [9],
  "expectedKeywords": ["embeddingStatus", "1", "vectorId", "KbChunk"],
  "difficulty": "medium"
}

### Case 7：检索模式
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "/api/rag/search 支持哪些检索模式？",
  "expectedAnswer": "支持 VECTOR_ONLY、KEYWORD_ONLY、HYBRID 和 HYBRID_RERANK 四种检索模式。",
  "expectedChunkIds": [10,11],
  "expectedKeywords": ["VECTOR_ONLY", "KEYWORD_ONLY", "HYBRID", "HYBRID_RERANK"],
  "difficulty": "easy"
}

### Case 8：SearchChunksRequest 参数
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "SearchChunksRequest 中 topK 和 candidateK 有什么区别？",
  "expectedAnswer": "topK 表示最终返回的 chunk 数量，candidateK 表示混合召回阶段的候选数量。",
  "expectedChunkIds": [10],
  "expectedKeywords": ["topK", "candidateK", "最终返回", "候选数量"],
  "difficulty": "medium"
}

### Case 9：HYBRID_RERANK 分数
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "HYBRID_RERANK 如何进行规则重排序？",
  "expectedAnswer": "HYBRID_RERANK 在混合召回结果上计算 exactTermScore 和 symbolScore，并结合 hybridScore 得到 rerankScore 或 finalScore。",
  "expectedChunkIds": [13,14],
  "expectedKeywords": ["HYBRID_RERANK", "exactTermScore", "symbolScore", "hybridScore", "finalScore"],
  "difficulty": "medium"
}

### Case 10：RAG ask 流程
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "RAG ask 的主要流程是什么？",
  "expectedAnswer": "RAG ask 会校验请求，构造 SearchChunksRequest，调用检索服务，使用 RagPromptBuilder 构建 prompt，调用 ChatClient 生成回答，并保存问答历史和引用。",
  "expectedChunkIds": [15,16],
  "expectedKeywords": ["SearchChunksRequest", "RagPromptBuilder", "ChatClient", "问答历史", "引用"],
  "difficulty": "medium"
}

### Case 11：QaReference 作用
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "QaReference 为什么能支持回答追溯？",
  "expectedAnswer": "QaReference 保存 assistant 回答引用的 chunk 信息，包括 chunkId、documentId、spaceId、chunkIndex、score 和 contentPreview。",
  "expectedChunkIds": [16],
  "expectedKeywords": ["QaReference", "assistant", "chunkId", "contentPreview", "追溯"],
  "difficulty": "medium"
}

### Case 12：Evaluation 指标
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "RAG Evaluation 模块中的 MRR 是如何计算的？",
  "expectedAnswer": "MRR 表示第一个正确 chunk 的倒数排名。如果第一个正确 chunk 排在第 r 位，则 MRR 为 1/r。",
  "expectedChunkIds": [18,19],
  "expectedKeywords": ["MRR", "正确 chunk", "倒数排名", "1/r"],
  "difficulty": "medium"
}

### 运行 VECTOR_ONLY EvalRun
POST {{host}}/api/rag/eval/runs
Content-Type: application/json

{
  "datasetId": {{datasetId}},
  "runName": "self-doc-vector-only",
  "retrievalMode": "VECTOR_ONLY",
  "topK": 5,
  "candidateK": 20,
  "vectorWeight": 0.7,
  "keywordWeight": 0.3,
  "enableAnswerGeneration": false
}

### 运行 KEYWORD_ONLY EvalRun
POST {{host}}/api/rag/eval/runs
Content-Type: application/json

{
  "datasetId": {{datasetId}},
  "runName": "self-doc-keyword-only",
  "retrievalMode": "KEYWORD_ONLY",
  "topK": 5,
  "candidateK": 20,
  "vectorWeight": 0.7,
  "keywordWeight": 0.3,
  "enableAnswerGeneration": false
}

### 运行 HYBRID EvalRun
POST {{host}}/api/rag/eval/runs
Content-Type: application/json

{
  "datasetId": {{datasetId}},
  "runName": "self-doc-hybrid",
  "retrievalMode": "HYBRID",
  "topK": 5,
  "candidateK": 20,
  "vectorWeight": 0.7,
  "keywordWeight": 0.3,
  "enableAnswerGeneration": false
}

### 运行 HYBRID_RERANK EvalRun
POST {{host}}/api/rag/eval/runs
Content-Type: application/json

{
  "datasetId": {{datasetId}},
  "runName": "self-doc-hybrid-rerank",
  "retrievalMode": "HYBRID_RERANK",
  "topK": 5,
  "candidateK": 20,
  "vectorWeight": 0.7,
  "keywordWeight": 0.3,
  "enableAnswerGeneration": false
}

### 对比多个 EvalRun
# 将 runIds 替换为上面四次运行返回的真实 runId
POST {{host}}/api/rag/eval/runs/compare
Content-Type: application/json

{
  "runIds": [5,6,7,8]
}
