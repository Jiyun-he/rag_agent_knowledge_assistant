@host = http://localhost:8080

# 占位 ID 说明（运行时必须替换为真实值，不要臆造数字）：
# @spaceId  —— 执行 01_import_docs_and_basic_test.http 第 1 步后，用响应 data.id 替换；
# @datasetId—— 执行 01_import_docs_and_basic_test.http 第 14 步后，用响应 data.id 替换；
# expectedChunkIds —— 先执行 GET /api/documents/{documentId}/chunks，把每个问题实际命中的 chunk id 填入，
#                     下面的数组只是示例形式，运行时需按真实 chunkId 替换。
@spaceId = 1
@datasetId = 1


### Case 1：项目整体链路
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "这个项目的完整 RAG 问答链路是什么？",
  "expectedAnswer": "项目链路包括知识库空间创建、文档创建、文本切分、chunk 存储、索引任务登记、Qdrant 向量索引与 Elasticsearch 关键词索引构建、RAG 检索、prompt 构建、大模型回答、问答历史保存和引用追踪。",
  "expectedChunkIds": [1,2],
  "expectedKeywords": ["知识库空间", "文档切分", "索引任务", "RAG 检索", "引用追踪"],
  "difficulty": "easy"
}

### Case 2：MySQL、Qdrant 与 Elasticsearch 分工
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "MySQL、Qdrant 和 Elasticsearch 在系统中分别负责什么？",
  "expectedAnswer": "MySQL 保存知识库空间、文档、chunk、索引任务、问答历史和评测记录等结构化数据；Qdrant 保存 chunk embedding 向量并提供向量相似度检索；Elasticsearch 配合 smartcn 中文分词提供关键词检索。",
  "expectedChunkIds": [1],
  "expectedKeywords": ["MySQL", "Qdrant", "Elasticsearch", "embedding", "关键词检索"],
  "difficulty": "easy"
}

### Case 3：KbChunk 作用
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "KbChunk 在项目中有什么作用？",
  "expectedAnswer": "KbChunk 表示文档切分后的文本片段，是索引构建、检索和引用追踪的基本单位。",
  "expectedChunkIds": [3,7],
  "expectedKeywords": ["KbChunk", "文本片段", "索引", "检索", "引用"],
  "difficulty": "easy"
}

### Case 4：文档创建后处理
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "创建文档后系统会做哪些处理？",
  "expectedAnswer": "系统会校验 spaceId，写入 KbDocument，调用 TextChunker 切分 content，将生成的片段写入 kb_chunk，并在事务提交后登记 BUILD_INDEX 索引任务由 worker 异步构建索引；索引完成前文档处于 INDEXING 状态。",
  "expectedChunkIds": [6,7],
  "expectedKeywords": ["spaceId", "KbDocument", "TextChunker", "BUILD_INDEX", "INDEXING"],
  "difficulty": "easy"
}

### Case 5：索引任务接口
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "POST /api/rag/documents/{documentId}/index 接口的作用是什么？",
  "expectedAnswer": "该接口用于手动触发 BUILD_INDEX 索引任务，登记任务后立即返回任务详情，由 IndexTaskWorker 异步为文档构建索引。",
  "expectedChunkIds": [8],
  "expectedKeywords": ["BUILD_INDEX", "索引任务", "IndexTaskWorker", "异步", "documentId"],
  "difficulty": "easy"
}

### Case 6：chunk 索引成功字段
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "chunk 索引成功后会更新哪些字段？",
  "expectedAnswer": "索引成功后会将该 KbChunk 的 embeddingStatus 更新为 1，并写入 vectorId。",
  "expectedChunkIds": [9],
  "expectedKeywords": ["embeddingStatus", "1", "vectorId", "KbChunk"],
  "difficulty": "medium"
}

### Case 7：检索模式
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "/api/rag/search 支持哪些检索模式？",
  "expectedAnswer": "支持 VECTOR_ONLY、KEYWORD_ONLY、HYBRID 和 HYBRID_RERANK 四种检索模式。",
  "expectedChunkIds": [10,11],
  "expectedKeywords": ["VECTOR_ONLY", "KEYWORD_ONLY", "HYBRID", "HYBRID_RERANK"],
  "difficulty": "easy"
}

### Case 8：SearchChunksRequest 参数
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "SearchChunksRequest 中 topK 和 candidateK 有什么区别？",
  "expectedAnswer": "topK 表示最终返回的 chunk 条数，candidateK 表示混合检索中每一路的召回深度，实际取 max(candidateK, topK)，默认 20。",
  "expectedChunkIds": [10],
  "expectedKeywords": ["topK", "candidateK", "最终返回", "召回深度"],
  "difficulty": "medium"
}

### Case 9：HYBRID_RERANK 分数
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "HYBRID_RERANK 如何进行重排序？",
  "expectedAnswer": "HYBRID 先用等权 RRF（RRF_K = 60）按排名融合向量召回与关键词召回；HYBRID_RERANK 再把融合后的候选（默认最多 30 条）发送给 TEI 的 /rerank 服务，把返回的重排分数作为 finalScore 降序返回。",
  "expectedChunkIds": [13,14],
  "expectedKeywords": ["HYBRID_RERANK", "RRF", "TEI", "rerank", "finalScore"],
  "difficulty": "medium"
}

### Case 10：RAG ask 流程
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "RAG ask 的主要流程是什么？",
  "expectedAnswer": "RAG ask 会校验请求，构造 SearchChunksRequest，调用检索服务，使用 RagPromptBuilder 构建 prompt，调用 ChatClient 生成回答，并保存问答历史和引用。",
  "expectedChunkIds": [15,16],
  "expectedKeywords": ["SearchChunksRequest", "RagPromptBuilder", "ChatClient", "问答历史", "引用"],
  "difficulty": "medium"
}

### Case 11：QaReference 作用
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "QaReference 为什么能支持回答追溯？",
  "expectedAnswer": "QaReference 保存 assistant 回答引用的 chunk 信息，包括 chunkId、documentId、spaceId、chunkIndex、score 和 contentPreview。",
  "expectedChunkIds": [16],
  "expectedKeywords": ["QaReference", "assistant", "chunkId", "contentPreview", "追溯"],
  "difficulty": "medium"
}

### Case 12：Evaluation 指标
POST {{host}}/api/rag/eval/datasets/{{datasetId}}/cases
Content-Type: application/json

{
  "question": "RAG Evaluation 模块中的 MRR 是如何计算的？",
  "expectedAnswer": "MRR 表示第一个正确 chunk 的倒数排名。如果第一个正确 chunk 排在第 r 位，则 MRR 为 1/r。",
  "expectedChunkIds": [18,19],
  "expectedKeywords": ["MRR", "正确 chunk", "倒数排名", "1/r"],
  "difficulty": "medium"
}

### 运行 VECTOR_ONLY EvalRun
POST {{host}}/api/rag/eval/runs
Content-Type: application/json

{
  "datasetId": {{datasetId}},
  "runName": "self-doc-vector-only",
  "retrievalMode": "VECTOR_ONLY",
  "topK": 5,
  "candidateK": 20,
  "enableAnswerGeneration": false
}

### 运行 KEYWORD_ONLY EvalRun
POST {{host}}/api/rag/eval/runs
Content-Type: application/json

{
  "datasetId": {{datasetId}},
  "runName": "self-doc-keyword-only",
  "retrievalMode": "KEYWORD_ONLY",
  "topK": 5,
  "candidateK": 20,
  "enableAnswerGeneration": false
}

### 运行 HYBRID EvalRun
POST {{host}}/api/rag/eval/runs
Content-Type: application/json

{
  "datasetId": {{datasetId}},
  "runName": "self-doc-hybrid",
  "retrievalMode": "HYBRID",
  "topK": 5,
  "candidateK": 20,
  "enableAnswerGeneration": false
}

### 运行 HYBRID_RERANK EvalRun
POST {{host}}/api/rag/eval/runs
Content-Type: application/json

{
  "datasetId": {{datasetId}},
  "runName": "self-doc-hybrid-rerank",
  "retrievalMode": "HYBRID_RERANK",
  "topK": 5,
  "candidateK": 20,
  "enableAnswerGeneration": false
}

### 对比多个 EvalRun
# runIds 是运行时才能确定的真实值：把上面四次运行响应中的 data.id 依次填入，不要臆造数字。
POST {{host}}/api/rag/eval/runs/compare
Content-Type: application/json

{
  "runIds": [5,6,7,8]
}
